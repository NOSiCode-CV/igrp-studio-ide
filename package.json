		"i18next": "^25.0.1",
		"i18next-browser-languagedetector": "^8.0.5",
		"i18next-electron-fs-backend": "^3.0.3",
		"input-otp": "^1.4.2",
		"js-yaml": "^4.1.0",
		"json-schema-faker": "^0.5.9",
		"knex": "^3.1.0",
		"knex-schema-inspector": "^3.1.0",
		"lucide-react": "^0.503.0",
		"monaco-editor": "^0.52.2",
		"mysql2": "^3.14.0",
		"next-themes": "^0.4.6",
