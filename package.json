{
    "name": "igrp-studio",
    "version": "0.2.0-beta.14",
    "license": "MIT",
    "description": "IGRP Studio for development",
    "main": "out/main/index.js",
    "author": "NOSi E.P.E - Núcleo Operacional para a Sociedade de Informação",
    "homepage": "igrp.cv",
    "scripts": {
        "typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
        "typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
        "typecheck": "npm run typecheck:node && npm run typecheck:web",
        "start": "electron-vite preview ",
        "dev": "electron-vite dev ",
        "dev:clean": "NODE_OPTIONS=--no-deprecation electron-vite dev ",
        "build": "npm run format && npm run typecheck && electron-vite build",
        "postinstall": "electron-builder install-app-deps",
        "build:unpack": "npm run build && electron-builder --dir",
        "release:mac": "electron-vite build && electron-builder --mac  --config --publish always",
        "release:mac:x64": "electron-vite build && electron-builder --mac --x64 --config --publish always",
        "release:linux": "electron-vite build && electron-builder --linux --config --publish always",
        "release:win": "electron-vite build && electron-builder --win --config --publish always",
        "release:mac:universal:signed": "./scripts/sign-and-build.sh --universal",
        "release:mac:x64:signed": "./scripts/sign-and-build.sh --x64",
        "release:mac:arm64:signed": "./scripts/sign-and-build.sh --arm64",
        "release:mac:all:signed": "npm run release:mac:universal:signed && npm run release:mac:x64:signed && npm run release:mac:arm64:signed",
        "test": "jest",
        "test:release-notes": "node scripts/test-release-notes-fetch.mjs",
        "test:release-notes:local": "node scripts/test-release-notes-fetch.mjs 0.2.0-beta.10.4 --local",
        "setup": "yarn install && yarn dev",
        "lint": "biome check --write",
        "format": "biome format --write",
        "docker:monitoring:up": "docker compose -f docker/monitoring/docker-compose.yml up -d",
        "docker:monitoring:down": "docker compose -f docker/monitoring/docker-compose.yml down",
        "rebuild:node-pty": "electron-rebuild -f -w node-pty",
        "build:markitdown-bin": "bash scripts/build-markitdown-bin.sh"
    },
    "dependencies": {
        "@electron-toolkit/preload": "^3.0.2",
        "@electron-toolkit/utils": "^4.0.0",
        "@faker-js/faker": "^10.3.0",
        "@gitbeaker/rest": "^43.8.0",
        "@hookform/resolvers": "^5.2.2",
        "@igrp/dotnet-engine": "^0.0.1-alpha.12",
        "@igrp/framework-process-studio-bpmn-editor": "0.0.1-beta.16",
        "@igrp/framework-process-studio-client": "^0.0.1-beta.12",
        "@igrp/framework-process-studio-types": "^0.0.1-beta.12",
        "@igrp/igrp-framework-react-design-system": "0.1.0-beta.103",
        "@igrp/igrp-studio-nextjs-engine": "0.2.0-beta.15",
        "@igrp/igrp-studio-springboot-engine": "0.1.0-beta.20-snapshot.4",
        "@igrp/igrp-studio-workspace-engine": "0.2.0-beta.6",
        "@lancedb/lancedb": "^0.27.2",
        "@monaco-editor/react": "^4.7.0",
        "@octokit/rest": "^22.0.1",
        "@radix-ui/react-tabs": "^1.1.13",
        "@reduxjs/toolkit": "^2.11.2",
        "@sentry/electron": "^7.9.0",
        "@tailwindcss/vite": "^4.2.1",
        "@tanstack/react-query": "^5.100.6",
        "@xterm/addon-fit": "^0.11.0",
        "@xterm/addon-search": "^0.16.0",
        "@xterm/addon-web-links": "^0.12.0",
        "@xterm/xterm": "^6.0.0",
        "@xyflow/react": "^12.8.6",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "date-fns": "^4.1.0",
        "docx": "^9.6.1",
        "dompurify": "^3.2.0",
        "dotenv": "^17.3.1",
        "electron-log": "^5.4.3",
        "electron-store": "^11.0.2",
        "electron-updater": "^6.8.3",
        "express": "^5.2.1",
        "highlight.js": "^11.10.0",
        "i18next": "^25.8.14",
        "i18next-browser-languagedetector": "^8.2.1",
        "i18next-electron-fs-backend": "^3.0.3",
        "js-yaml": "^4.1.1",
        "knex": "^3.1.0",
        "knex-schema-inspector": "^3.1.0",
        "lucide-react": "^0.577.0",
        "markdown-it": "^14.1.0",
        "monaco-editor": "^0.55.1",
        "motion": "^12.38.0",
        "mysql2": "^3.19.0",
        "next-themes": "^0.4.6",
        "node-pty": "^1.1.0",
        "oracledb": "^6.10.0",
        "path-browserify": "^1.0.1",
        "pg": "^8.20.0",
        "radix-ui": "^1.4.3",
        "react-hook-form": "^7.76.0",
        "react-i18next": "^16.5.6",
        "react-markdown": "^10.1.0",
        "react-redux": "^9.2.0",
        "react-resizable-panels": "^4.7.1",
        "react-router-dom": "^7.13.1",
        "remark-gfm": "^4.0.1",
        "tailwind-merge": "^3.5.0",
        "tailwindcss-animate": "^1.0.7",
        "use-debounce": "^10.1.0",
        "uuid": "^13.0.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@biomejs/biome": "2.4.6",
        "@electron-toolkit/tsconfig": "^2.0.0",
        "@electron/rebuild": "^4.0.3",
        "@tailwindcss/postcss": "^4.2.1",
        "@tailwindcss/typography": "^0.5.15",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@types/express": "^5.0.6",
        "@types/github-url-to-object": "^4.0.4",
        "@types/jest": "^30.0.0",
        "@types/markdown-it": "^14.1.2",
        "@types/node": "^20.19.0",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.2.3",
        "@vitejs/plugin-react": "^5.1.4",
        "electron": "40.8.0",
        "electron-builder": "^26.8.1",
        "electron-builder-squirrel-windows": "26.8.1",
        "electron-devtools-installer": "^4.0.0",
        "electron-vite": "^5.0.0",
        "jest": "^30.2.0",
        "jest-environment-jsdom": "^30.2.0",
        "postcss": "^8.5.8",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "tailwindcss": "^4.2.1",
        "ts-jest": "^29.4.6",
        "ts-node": "^10.9.2",
        "typescript": "^5.9.3",
        "vite": "^7.3.1"
    },
    "optionalDependencies": {
        "dmg-license": "^1.0.11"
    },
    "build": {
        "productName": "IGRP Studio",
        "appId": "cv.nosi.igrpstudio.alpha",
        "artifactName": "IGRP-Studio-${version}-${arch}.${ext}",
        "publish": {
            "provider": "s3",
            "bucket": "igrp-studio",
            "region": "praia",
            "endpoint": "https://storage-api.nosi.cv",
            "channel": "${env.PUBLISH_CHANNEL}",
            "path": "${platform}/${arch}/"
        },
        "win": {
            "icon": "resources/icons/icon.ico",
            "target": "nsis",
            "signtoolOptions": {
                "certificateFile": "certificate.pfx",
                "certificatePassword": "__CERT_PASS__",
                "signingHashAlgorithms": [
                    "sha256"
                ],
                "rfc3161TimeStampServer": "http://timestamp.digicert.com",
                "publisherName": "NOSI – Núcleo Operacional Sistema Informação, E.P.E."
            },
            "extraResources": [
                {
                    "from": "resources/markitdown-bin/win",
                    "to": "markitdown-bin/win",
                    "filter": [
                        "**/*"
                    ]
                }
            ],
            "publish": {
                "provider": "s3",
                "bucket": "igrp-studio",
                "region": "praia",
                "endpoint": "https://storage-api.nosi.cv",
                "channel": "${env.PUBLISH_CHANNEL}",
                "path": "win32/${arch}/"
            }
        },
        "mac": {
            "icon": "resources/icons/icon.icns",
            "category": "public.app-category.developer-tools",
            "identity": "NOSi (QT6DP36974)",
            "type": "distribution",
            "entitlements": "build/entitlements.mac.plist",
            "entitlementsInherit": "build/entitlements.mac.plist",
            "hardenedRuntime": true,
            "gatekeeperAssess": false,
            "notarize": true,
            "extraResources": [
                {
                    "from": "resources/markitdown-bin/mac",
                    "to": "markitdown-bin/mac",
                    "filter": [
                        "**/*"
                    ]
                }
            ]
        },
        "linux": {
            "icon": "resources/icons/icon.png",
            "target": [
                "AppImage",
                "deb"
            ],
            "category": "Development",
            "maintainer": "NOSI - Núcleo Operacional Sistema Informação, E.P.E.",
            "extraResources": [
                {
                    "from": "resources/markitdown-bin/linux",
                    "to": "markitdown-bin/linux",
                    "filter": [
                        "**/*"
                    ]
                }
            ]
        },
        "protocols": [
            {
                "name": "IGRP Studio",
                "schemes": [
                    "igrp-studio"
                ]
            }
        ],
        "files": [
            "package.json",
            "out/**/*",
            "!out/**/*.map",
            "node_modules/**/*"
        ],
        "extraResources": [
            "node_modules/node-pty/build/**"
        ],
        "asar": true
    }
}
