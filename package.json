		"@igrp/igrp-studio-nextjs-engine": "0.0.1-alpha.163",
		"@igrp/igrp-studio-springboot-engine": "0.0.1-alpha.79",
		"@monaco-editor/react": "^4.7.0",
		"@octokit/rest": "^21.1.1",
		"@radix-ui/react-accordion": "^1.2.8",
		"@radix-ui/react-alert-dialog": "^1.1.11",
