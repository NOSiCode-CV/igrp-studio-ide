{
	"name": "igrp-studio",
	"version": "0.1.0-beta.2",
	"description": "IGRP Studio for development",
	"main": "out/main/index.js",
	"author": "NOSi E.P.E - Núcleo Operacional Para a Sociedade de Informação",
	"homepage": "igrp.cv",
	"scripts": {
		"clean": "yarn clean && yarn install",
		"format": "prettier --write .",
		"lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
		"typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
		"typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
		"typecheck": "npm run typecheck:node && npm run typecheck:web",
		"start": "electron-vite preview ",
		"dev": "electron-vite dev ",
		"runnig": "yarn install && yarn dev",
		"build": "npm run typecheck && electron-vite build ",
		"postinstall": "electron-builder install-app-deps",
		"build:unpack": "npm run build && electron-builder --dir",
		"release:mac": "electron-vite build && electron-builder --mac  --config --publish always",
		"release:mac:x64": "electron-vite build && electron-builder --mac --x64 --config --publish always",
		"release:linux": "electron-vite build && electron-builder --linux --config --publish always",
		"release:win": "electron-vite build && electron-builder --win --config --publish always",
		"test": "jest",
		"grpc-server": "node grpc-server.js"
	},
