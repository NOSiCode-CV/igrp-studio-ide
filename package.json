		"@igrp/igrp-studio-nextjs-engine": "0.0.1-alpha.2",
		"@igrp/igrp-studio-springboot-engine": "^0.0.1-alpha.10",
		"@igrp/nextjs-engine": "^0.1.7",
		"@monaco-editor/react": "^4.7.0",
		"@octokit/rest": "^21.1.1",
		"@radix-ui/react-accordion": "^1.2.3",
