	"build": {
		"productName": "IGRP Studio",
		"appId": "cv.nosi.igrpstudio.alpha",
		"artifactName": "IGRP-Studio-${version}-${arch}.${ext}",
		"publish": {
			"provider": "s3",
			"bucket": "igrp-studio",
			"region": "praia",
			"endpoint": "https://storage-api.nosi.cv",
			"channel": "latest",
			"path": "${platform}/${arch}/"
		},
		"win": {
			"icon": "resources/icons/icon.ico",
			"target": "nsis",
			"signtoolOptions": {
				"certificateFile": "certificate.pfx",
				"certificatePassword": "__CERT_PASS__",
				"signingHashAlgorithms": [
					"sha256"
				],
				"rfc3161TimeStampServer": "http://timestamp.digicert.com",
				"publisherName": "NOSi E.P.E <contact@nosi.cv>"
			},
			"publish": {
				"provider": "s3",
				"bucket": "igrp-studio",
				"region": "praia",
				"endpoint": "https://storage-api.nosi.cv",
				"channel": "latest",
				"path": "win32/${arch}/"
			}
		},
		"mac": {
			"icon": "resources/icons/icon.icns",
			"category": "public.app-category.developer-tools",
			"entitlementsInherit": "build/entitlements.mac.plist",
			"notarize": false
		},
		"linux": {
			"icon": "resources/icons/icon.png",
			"target": [
				"AppImage",
				"deb"
			],
			"category": "Development",
			"maintainer": "NOSi E.P.E <contact@nosi.cv>"
		},
		"protocols": [
			{
				"name": "IGRP Studio",
				"schemes": [
					"igrp-studio"
				]
			}
		],
		"files": [
			"out/**/*",
			"!out/**/*.map"
		]
	}
}
