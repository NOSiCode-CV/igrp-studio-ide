		"tailwindcss-animate": "^1.0.7",
		"ts-jest": "^29.3.2",
		"update-electron-app": "^3.1.1",
		"vaul": "^1.1.2",
		"yup": "^1.6.1",
		"zod": "^3.24.3"
	},
	"devDependencies": {
		"@electron-toolkit/eslint-config-prettier": "^3.0.0",
		"@electron-toolkit/eslint-config-ts": "^3.1.0",
		"@electron-toolkit/tsconfig": "^1.0.1",
		"@tailwindcss/postcss": "^4.1.4",
		"@types/node": "^22.14.1",
		"@types/react": "^19.1.2",
		"@types/react-dom": "^19.1.2",
		"@vitejs/plugin-react": "^4.4.1",
		"electron": "35.2.0",
		"electron-builder": "^26.0.12",
		"electron-builder-squirrel-windows": "26.0.12",
		"electron-devtools-installer": "^4.0.0",
		"electron-vite": "^3.1.0",
		"eslint": "^9.25.1",
		"eslint-plugin-react": "^7.37.5",
		"jest": "^29.7.0",
		"postcss": "^8.5.3",
		"prettier": "^3.5.3",
		"react": "^19.1.0",
		"react-dom": "^19.1.0",
		"tailwindcss": "^4.1.4",
		"ts-node": "^10.9.2",
		"typescript": "^5.8.3",
		"vite": "^6.3.2"
	},
	"resolutions": {
		"@radix-ui/react-dismissable-layer": "^1.1.5"
	},
	"optionalDependencies": {
		"dmg-license": "^1.0.11"
	},
	"build": {
		"productName": "IGRP Studio",
		"appId": "cv.nosi.igrpstudio.alpha",
		"artifactName": "IGRP-Studio-${version}-${arch}.${ext}",
		"win": {
			"icon": "resources/icons/icon.ico",
			"target": "nsis",
			"signtoolOptions": {
				"certificateFile": "certificate.pfx",
				"certificatePassword": "__CERT_PASS__",
				"signingHashAlgorithms": [
					"sha256"
				],
				"rfc3161TimeStampServer": "http://timestamp.digicert.com",
				"publisherName": "NOSi E.P.E <contact@nosi.cv>"
			}
		},
		"mac": {
			"icon": "resources/icons/icon.icns",
			"category": "public.app-category.developer-tools",
			"entitlementsInherit": "build/entitlements.mac.plist",
			"notarize": false
		},
		"linux": {
			"icon": "resources/icons/icon.png",
			"target": [
				"AppImage",
				"deb"
			],
			"category": "Development",
			"maintainer": "NOSi E.P.E <contact@nosi.cv>"
		},
		"protocols": [
			{
				"name": "IGRP Studio",
				"schemes": [
					"igrp-studio"
				]
			}
		],
		"files": [
			"out/**/*",
			"!out/**/*.map"
		],
		"publish": {
			"provider": "s3",
			"bucket": "igrp-studio",
			"region": "praia",
			"endpoint": "https://storage-api.nosi.cv",
			"channel": "latest",
			"path": "${platform}/${arch}/"
		}
	}
}
