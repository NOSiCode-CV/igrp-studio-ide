{
	"name": "igrp-studio",
	"version": "1.0.0-alpha",
	"description": "IGRP Studio for dev",
	"main": "./out/main/index.js",
	"author": "nosi.cv",
	"homepage": "igrp.cv",
	"scripts": {
		"format": "prettier --write .",
		"lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
		"typecheck:node": "tsc --noEmit -p tsconfig.node.json --composite false",
		"typecheck:web": "tsc --noEmit -p tsconfig.web.json --composite false",
		"typecheck": "npm run typecheck:node && npm run typecheck:web",
		"start": "electron-vite preview",
		"dev": "electron-vite dev",
		"build": "npm run typecheck && electron-vite build",
		"postinstall": "electron-builder install-app-deps",
		"build:unpack": "npm run build && electron-builder --dir",
		"build:win": "npm run build && electron-builder --win",
		"build:mac": "electron-vite build && electron-builder --mac",
		"build:linux": "electron-vite build && electron-builder --linux",
		"prebuild": "cp -R src/renderer/src/i18n/locales build/locales"
	},
	"dependencies": {
		"@electron-toolkit/preload": "^3.0.1",
		"@electron-toolkit/utils": "^3.0.0",
		"@faker-js/faker": "^9.2.0",
		"@igrp/igrp-design-system": "^1.0.0-alpha.18",
		"@igrp/nextjs-engine": "^0.0.5",
		"@igrp/spring-engine": "^0.3.0-alpha-4.2.3",
		"@radix-ui/react-accordion": "^1.2.1",
		"@radix-ui/react-alert-dialog": "^1.1.2",
		"@radix-ui/react-avatar": "^1.1.1",
		"@radix-ui/react-checkbox": "^1.1.2",
		"@radix-ui/react-collapsible": "^1.1.1",
		"@radix-ui/react-dialog": "^1.1.2",
		"@radix-ui/react-dropdown-menu": "^2.1.2",
		"@radix-ui/react-label": "^2.1.0",
		"@radix-ui/react-popover": "^1.1.2",
		"@radix-ui/react-radio-group": "^1.2.1",
		"@radix-ui/react-scroll-area": "^1.2.0",
		"@radix-ui/react-select": "^2.1.2",
		"@radix-ui/react-separator": "^1.1.0",
		"@radix-ui/react-slot": "^1.1.0",
		"@radix-ui/react-tabs": "^1.1.1",
		"@radix-ui/react-tooltip": "^1.1.3",
		"@reduxjs/toolkit": "^2.3.0",
		"@shadcn/ui": "^0.0.4",
		"@types/jest": "^29.5.14",
		"@uiw/react-codemirror": "^4.23.6",
		"class-variance-authority": "^0.7.0",
		"clsx": "^2.1.1",
		"cmdk": "^1.0.4",
		"date-fns": "^4.1.0",
		"electron-updater": "^6.1.7",
		"formik": "^2.4.6",
		"i18next": "^23.16.4",
		"i18next-browser-languagedetector": "^8.0.0",
		"i18next-electron-fs-backend": "^3.0.2",
		"lucide-react": "^0.454.0",
		"react-beautiful-dnd": "^13.1.1",
		"react-day-picker": "^9.3.2",
		"react-i18next": "^15.1.1",
		"react-redux": "^9.1.2",
		"react-router-dom": "^6.28.0",
		"react-toastify": "^10.0.6",
		"reselect": "^5.1.1",
		"tailwind-merge": "^2.5.4",
		"tailwindcss-animate": "^1.0.7",
		"ts-jest": "^29.2.5",
		"yup": "^1.4.0"
	},
	"devDependencies": {
		"@electron-toolkit/eslint-config-prettier": "^2.0.0",
		"@electron-toolkit/eslint-config-ts": "^2.0.0",
		"@electron-toolkit/tsconfig": "^1.0.1",
		"@types/node": "^20.14.8",
		"@types/react": "^18.3.3",
		"@types/react-dom": "^18.3.0",
		"@vitejs/plugin-react": "^4.3.1",
		"autoprefixer": "^10.4.20",
		"electron": "^31.0.2",
		"electron-builder": "^24.13.3",
		"electron-devtools-installer": "^3.2.0",
		"electron-vite": "^2.3.0",
		"eslint": "^8.57.0",
		"eslint-plugin-react": "^7.34.3",
		"jest": "^29.7.0",
		"postcss": "^8.4.47",
		"prettier": "^3.3.2",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"tailwindcss": "^3.4.14",
		"ts-node": "^10.9.2",
		"typescript": "^5.6.3",
		"vite": "^5.3.1"
	},
	"build": {
		"productName": "IGRP Studio",
		"appId": "cv.nosi.igrp.studio",
		"win": {
			"icon": "build/icon.ico"
		},
		"mac": {
			"icon": "build/icons/icon.icns"
		},
		"linux": {
			"icon": "build/icons/icon.png"
		},
		"extraResources": [
			{
				"from": "./src/renderer/src/i18n/locales",
				"to": "renderer/locales"
			}
		]
	}
}
