{
  "files": [],
  "references": [{ "path": "./tsconfig.node.json" }, { "path": "./tsconfig.web.json" }],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"]
    },
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["jest"],
    "skipLibCheck": true,
    "noImplicitAny": false, // Adicione isto
    "strictNullChecks": false, // E isto
    "strict": false, // Mude para false
    "allowJs": true, // Adicione isto
  }
}
