PUBLIC_URL=
VITE_APP_TITLE=IGRP Studio
RENDERER_VITE_API_IGRP_VERSIONS='https://sonatype.nosi.cv/service/rest/v1/search?repository=igrp-framework-releases&group=cv.igrp.framework&name=core'

VITE_GIT_REDIRECT_URI=igrp-studio://oauth/callback

# OAuth client ids are safe to ship in the renderer bundle (identifiers,
# not secrets). The matching client SECRETS must NOT be prefixed with
# `VITE_` — otherwise Vite inlines them in the shipped JS bundle, and
# anyone with the installer can `grep` the client secret out. Keep the
# secrets as plain `*_CLIENT_SECRET` env vars so only the main process
# (via dotenv.config()) ever sees them, never the renderer.
VITE_GITHUB_CLIENT_ID=your-github-oauth-client-id
GITHUB_CLIENT_SECRET=rotated-github-oauth-client-secret

VITE_GITLAB_BASE_URL=https://git.nosi.cv
VITE_GITLAB_CLIENT_ID=your-gitlab-oauth-client-id
GITLAB_CLIENT_SECRET=rotated-gitlab-oauth-client-secret

VITE_DEV_PORT=3000
VITE_NODE_ENV=development

VITE_ENDPOINT_UPDATE_IGRP_STUDIO='https://storage-api.nosi.cv'

# stable | beta
PUBLISH_CHANNEL=beta

# GlitchTip DSN — same value as GlitchTip → Project settings → Client Keys
SENTRY_DSN=
